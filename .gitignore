# Ignore bundler config and vendored gems.
/.bundle
/vendor/bundle

# Ignore environment files, but keep templates.
.env
.env.*
!.env.example
!.env.*.example

# Ignore Rails key files and credentials keys.
/config/master.key
/config/credentials/*.key

# Ignore logs and temporary files, keeping the directories.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore local Active Storage files and local databases.
/storage/*
!/storage/.keep
*.sqlite3
*.sqlite3-*

# Ignore generated test and coverage artifacts.
/coverage/
/spec/examples.txt
/.rspec_status
/rspec_results.xml

# Ignore compiled assets.
/public/assets
/public/packs
/public/packs-test

# Ignore Node dependencies and frontend build artifacts.
node_modules/
**/node_modules/
/frontend/dist/
/frontend/build/
/frontend/.vite/
/dist/
/build/
.vite/
.parcel-cache/
.next/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*

# Ignore editor files.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Ignore operating-system files.
.DS_Store
Thumbs.db

/log/
/storage/
/tmp/
# Frontend build copied into the Rails image or public/ for local checks.
/public/index.html
/public/assets/
