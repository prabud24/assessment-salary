# Copy to `.env` (git-ignored) and fill in. Never commit real values.
POSTGRES_PASSWORD=
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=
# Comma-separated hostnames the app is served from (required in production; Compose defaults to localhost)
RAILS_ALLOWED_HOSTS=localhost
# Optional
# POSTGRES_USER=salary
# POSTGRES_DB=assessment_salary_production
# APP_PORT=3000
# RAILS_LOG_LEVEL=info
# Only needed when running the seed service
# HR_MANAGER_EMAIL=
# HR_MANAGER_PASSWORD=
